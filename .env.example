# Headquarters environment reference.
#
# Sections 1–2 belong in the repo-root `.env` (read by SvelteKit and the Supabase CLI).
# `scripts/dev-up.sh` copies this file to `.env` on first run and fills in the Supabase
# URL + anon key from `supabase status`; keys you set yourself are never overwritten.
#
# Section 3 lists Edge Function secrets. They are NOT read from the root `.env`:
#   - local:  put them in `supabase/functions/.env` (loaded by `supabase start` /
#             `supabase functions serve`; gitignored)
#   - hosted: `supabase secrets set --env-file <file>` or `supabase secrets set KEY=value`
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions by
# Supabase automatically — never put the service-role key in this file or the app env.

# ---------------------------------------------------------------------------
# 1. SvelteKit app (root .env locally; process env in production)
# ---------------------------------------------------------------------------

# Supabase Auth + PostgREST/Kong public URL (no trailing slash).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (publishable) key — safe for the browser; never the service-role key.
PUBLIC_SUPABASE_ANON_KEY=

# Optional absolute API origin (no trailing slash). Empty = same-origin `/api/v1/...`,
# proxied server-side by `src/routes/api/v1/[...path]/+server.ts` (recommended).
PUBLIC_API_BASE_URL=

# Optional server-only upstream for the same-origin `/api/v1` proxy.
# Defaults to `${PUBLIC_SUPABASE_URL}/functions/v1/api-v1`.
API_V1_UPSTREAM=

# Login providers to show. Comma-separated subset of: google,azure,sso
# Only list providers that are enabled in Supabase Auth.
PUBLIC_AUTH_PROVIDERS=

# Hosted SaaS billing mode — leave all four unset for self-hosting.
# When true, open /signup without a paid claim token is blocked (invites still work).
PUBLIC_HOSTED_BILLING=
# Origin of the separate billing service (no trailing slash).
PUBLIC_BILLING_API_URL=
# Marketing site origin for "go to pricing" links (no trailing slash).
PUBLIC_LANDING_URL=
# Shared secret with the billing service (server-only).
BILLING_CLAIM_SECRET=

# Production only (adapter-node, `pnpm build && pnpm start`): public origin of the app,
# required for SvelteKit's form-action CSRF check. Also supports PORT (default 3000),
# HOST, and PROTOCOL_HEADER/HOST_HEADER behind a reverse proxy.
# ORIGIN=https://crm.example.com

# ---------------------------------------------------------------------------
# 2. Supabase CLI — resolved via env() in supabase/config.toml (local stack only)
# ---------------------------------------------------------------------------

# Social login for the local stack. Also set `enabled = true` for the provider in
# supabase/config.toml and add it to PUBLIC_AUTH_PROVIDERS.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=

# Optional: enables Supabase AI in local Studio only (not used by the app).
# OPENAI_API_KEY=

# Kept for dev-status.sh display; the app itself does not read it (see section 3).
APP_BASE_URL=http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 3. Edge Function secrets (supabase/functions/.env or `supabase secrets set`)
#    Uncomment in the right file — values in the root .env are ignored by functions.
# ---------------------------------------------------------------------------

# api-v1 CORS allow-origin. Defaults to "*" with a warning; set the app origin in
# production (browser traffic normally goes through the same-origin proxy anyway).
# API_CORS_ORIGIN=https://crm.example.com

# App URL used to build links in emails (e.g. invitation accept links). Falls back to
# the request Origin header when unset.
# APP_BASE_URL=https://crm.example.com

# Browser-reachable Supabase origin used to rewrite signed Storage URLs minted from the
# internal SUPABASE_URL. STORAGE_PUBLIC_URL wins over PUBLIC_SUPABASE_URL. Usually only
# needed for self-hosted / LAN stacks; hosted Supabase URLs are already public.
# STORAGE_PUBLIC_URL=
# PUBLIC_SUPABASE_URL=

# Cron-triggered functions (verify_jwt = false). Each scheduler call must send the
# matching header. Generate with `openssl rand -hex 32`.
#   mailbox-sync            header x-mailbox-sync-secret            (every minute;
#                           migrations also schedule it via pg_cron using the Vault
#                           secret `mailbox_sync_secret`, so the env var is optional)
#   jobs-recurring-invoices header x-recurring-invoices-cron-secret (every 1–5 min)
#   jobs-playbooks          header x-playbooks-cron-secret
#   jobs-campaigns          header x-campaigns-cron-secret (falls back to PLAYBOOKS_CRON_SECRET)
# MAILBOX_SYNC_SECRET=
# RECURRING_INVOICES_CRON_SECRET=
# PLAYBOOKS_CRON_SECRET=
# CAMPAIGNS_CRON_SECRET=

# Personal mailbox OAuth (My settings → Mail). Separate from Supabase Auth social login
# and from Google Calendar OAuth. Redirect URIs point at the app callback:
#   <app origin>/settings/mailbox-oauth/callback
# MICROSOFT_MAILBOX_CLIENT_ID=
# MICROSOFT_MAILBOX_CLIENT_SECRET=
# MICROSOFT_MAILBOX_REDIRECT_URI=
# GOOGLE_MAILBOX_CLIENT_ID=
# GOOGLE_MAILBOX_CLIENT_SECRET=
# GOOGLE_MAILBOX_REDIRECT_URI=

# Google Calendar OAuth (My settings → Calendar).
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=

# Test-only stubs (1/true/yes). Never enable in production.
#   MAILBOX_OAUTH_STAGING_STUB  complete mailbox OAuth without a live IdP (code=stub)
#   CALENDAR_SYNC_STAGING_STUB  stub Google Calendar + CalDAV sync
#   CALDAV_SYNC_STAGING_STUB    stub CalDAV sync only
#   AI_COMPLETION_STUB          return canned AI completions instead of calling a provider
# MAILBOX_OAUTH_STAGING_STUB=
# CALENDAR_SYNC_STAGING_STUB=
# CALDAV_SYNC_STAGING_STUB=
# AI_COMPLETION_STUB=
