# Optional absolute API origin (no trailing slash). Empty / unset = same-origin `/api/v1/...`.
# Read at the SvelteKit composition root via `$env/dynamic/public` and passed into createApiV1Client.
# Optional: may be absent in fresh checkouts — do not import as a static named export.
# Staging deploy leaves this empty so the browser only sees `/api/v1/*`
# (proxied by `src/routes/api/v1/[...path]/+server.ts`).
PUBLIC_API_BASE_URL=

# Supabase Auth + PostgREST/Kong public URL (no trailing slash).
# Staging deploy writes this from `supabase status` (LAN host:port).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (publishable) key — safe for the browser; never the service-role key.
PUBLIC_SUPABASE_ANON_KEY=

# Optional local social-login credentials. Leave providers disabled in
# supabase/config.toml until these are configured.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=

# Server-only upstream for the same-origin `/api/v1` proxy.
# Defaults to `${PUBLIC_SUPABASE_URL}/functions/v1/api-v1` or local Kong.
API_V1_UPSTREAM=

# Internal secret required by the mailbox-sync cron function (verify_jwt=false).
# Set as an edge function secret; the scheduler must send it in `x-mailbox-sync-secret`.
MAILBOX_SYNC_SECRET=

# Internal secret required by jobs-recurring-invoices (verify_jwt=false).
# Scheduler must send it in `x-recurring-invoices-cron-secret`.
RECURRING_INVOICES_CRON_SECRET=

# System sender used by organisation invitation emails. Local Supabase Mailpit
# accepts unauthenticated SMTP on port 54325 when that port is enabled.
SYSTEM_SMTP_HOST=host.docker.internal
SYSTEM_SMTP_PORT=54325
SYSTEM_SMTP_SECURITY=none
SYSTEM_SMTP_USERNAME=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_FROM=headquarters@localhost
APP_BASE_URL=http://127.0.0.1:5173

# Enterprise SAML SSO providers are registered against the hosted Supabase Auth
# project (CLI/dashboard), not with a client secret in this application.
