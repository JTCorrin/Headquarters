# Optional absolute API origin (no trailing slash). Empty / unset = same-origin `/api/v1/...`.
# Read at the SvelteKit composition root via `$env/dynamic/public` and passed into createApiV1Client.
# Optional: may be absent in fresh checkouts — do not import as a static named export.
# Staging deploy leaves this empty so the browser only sees `/api/v1/*`
# (proxied by `src/routes/api/v1/[...path]/+server.ts`).
PUBLIC_API_BASE_URL=

# Supabase Auth + PostgREST/Kong public URL (no trailing slash).
# Staging deploy writes this from `supabase status` (LAN host:port).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (publishable) key — safe for the browser; never the service-role key.
PUBLIC_SUPABASE_ANON_KEY=

# Optional local social-login credentials. Leave providers disabled in
# supabase/config.toml until these are configured.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=

# Server-only upstream for the same-origin `/api/v1` proxy.
# Defaults to `${PUBLIC_SUPABASE_URL}/functions/v1/api-v1` or local Kong.
API_V1_UPSTREAM=

# Internal secret required by the mailbox-sync cron function (verify_jwt=false).
# Set as an edge function secret; the every-minute scheduler sends it in
# `x-mailbox-sync-secret`, while the SQL due-list enforces each mailbox interval.
MAILBOX_SYNC_SECRET=

# Personal mailbox OAuth (My settings → Mail). Separate from Supabase Auth Google/Azure
# login and from GOOGLE_CALENDAR_* calendar OAuth.
# Redirect URIs should point at the app callback, e.g.
#   ${APP_BASE_URL}/settings/mailbox-oauth/callback
MICROSOFT_MAILBOX_CLIENT_ID=
MICROSOFT_MAILBOX_CLIENT_SECRET=
MICROSOFT_MAILBOX_REDIRECT_URI=
GOOGLE_MAILBOX_CLIENT_ID=
GOOGLE_MAILBOX_CLIENT_SECRET=
GOOGLE_MAILBOX_REDIRECT_URI=
# Set to 1/true/yes in staging to complete OAuth without live IdPs (code=stub).
MAILBOX_OAUTH_STAGING_STUB=

# Google Calendar OAuth (My settings → Calendar). Separate from mailbox OAuth.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
CALENDAR_SYNC_STAGING_STUB=

# Internal secret required by jobs-recurring-invoices (verify_jwt=false).
# Scheduler must send it in `x-recurring-invoices-cron-secret`.
RECURRING_INVOICES_CRON_SECRET=

# Mail campaign send worker (jobs-campaigns). Header: x-campaigns-cron-secret.
# Falls back to PLAYBOOKS_CRON_SECRET when unset.
CAMPAIGNS_CRON_SECRET=
PLAYBOOKS_CRON_SECRET=

# Invitation accept links fall back to the browser Origin header when unset.
# Preferred for local/staging so emailed links hit the correct app URL.
APP_BASE_URL=http://127.0.0.1:5173

# Hosted SaaS billing (Railway production only). Leave unset for self-host.
# When true, open /signup without a paid claim token is blocked (invites still work).
PUBLIC_HOSTED_BILLING=
# Origin of headquarters-billing (no trailing slash), e.g. https://hq-billing.up.railway.app
PUBLIC_BILLING_API_URL=
# Marketing site origin for “go to pricing” links (no trailing slash).
PUBLIC_LANDING_URL=
# Shared secret with headquarters-billing CLAIM_SHARED_SECRET (server-only).
BILLING_CLAIM_SECRET=

# Organisation invitations are sent via the inviter's personal mailbox SMTP
# (My settings → Mail). Platform SYSTEM_SMTP_* is no longer used for invites.

# Enterprise SAML SSO providers are registered against the hosted Supabase Auth
# project (CLI/dashboard), not with a client secret in this application.
